{
  "name": "hnst-web",
  "version": "0.1.0",
  "private": true,
  "description": "HONEST Marketing website (hnst.marketing). Built on Satus by darkroom.engineering (MIT).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "bun ./lib/scripts/dev.ts",
    "dev:https": "bun ./lib/scripts/dev.ts --https",
    "build": "bun run setup:styles && next build",
    "start": "next start",
    "preview": "bun run build && next start",
    "prepare": "bun ./lib/scripts/prepare.ts",
    "check": "bun run --parallel --no-exit-on-error lint format:check lint:types typecheck test:oxlint-plugin manifest:check check:assets check:disables check:colors contracts:check && bun run test",
    "clean": "rm -rf .next node_modules/.cache",
    "lint": "oxlint --report-unused-disable-directives --max-warnings=0",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "lint:types": "oxlint --type-aware --max-warnings=0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "ensure:typegen": "test -f next-env.d.ts && test -f .next/types/routes.d.ts && test -f .next/types/root-params.d.ts || next typegen",
    "typecheck": "bun run ensure:typegen && bun node_modules/typescript/bin/tsc --noEmit",
    "typecheck:watch": "bun run ensure:typegen && bun node_modules/typescript/bin/tsc --noEmit --watch",
    "deslop": "deslop",
    "analyze": "next analyze",
    "analyze:snapshot": "next analyze --output --snapshot",
    "dev:inspect": "bun ./lib/scripts/dev.ts --inspect",
    "lighthouse": "bunx @unlighthouse/cli --site http://localhost:3000",
    "bench:nav": "bun ./lib/scripts/bench-navigation.ts",
    "bench:rerender": "bun ./lib/scripts/bench-rerender.ts",
    "setup:project": "echo 'This project is already set up — setup:project deletes itself after its first run. Run `git log -- lib/scripts/setup-project.ts` (or check out an earlier commit) to find it again.' && exit 1",
    "test": "bun test --parallel",
    "test:e2e": "playwright test",
    "test:oxlint-plugin": "for f in tools/oxlint/*/rules/*.ruletest.ts; do node $f || exit 1; done",
    "doctor": "bun ./lib/scripts/doctor.ts",
    "env:setup": "bun ./lib/scripts/env-setup.ts",
    "contrast:accept": "bun ./lib/styles/scripts/contrast-accept.ts",
    "setup:styles": "bun ./lib/styles/scripts/setup-styles.ts",
    "generate:manifest": "bun ./lib/scripts/generate-manifest.ts",
    "manifest:check": "bun ./lib/scripts/generate-manifest.ts --check",
    "check:assets": "bun ./lib/scripts/check-assets.ts",
    "check:disables": "bun ./lib/scripts/check-lint-disables.ts",
    "tokens": "bun run setup:styles",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "check:colors": "bun ./lib/scripts/check-colors.ts",
    "contracts:openapi": "bun ./lib/scripts/generate-openapi.ts",
    "contracts:check": "bun ./lib/scripts/generate-openapi.ts --check",
    "handoff": "bun ./lib/scripts/prepare-handoff.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@base-ui/react": "^1.9.0",
    "@dotenvx/dotenvx": "^2.38.2",
    "@dotenvx/next-env": "^2.4.12",
    "@gohighlevel/api-client": "^3.1.1",
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "altcha": "^3.5.0",
    "altcha-lib": "^2.8.0",
    "animejs": "^4.5.0",
    "bottleneck": "^2.19.5",
    "clsx": "^2.1.1",
    "detect-gpu": "^5.0.70",
    "graphql": "^16.8.1",
    "hamo": "^1.0.3",
    "lenis": "2.0.0-dev.5",
    "next": "16.4.3",
    "node-pg-migrate": "^9.0.0",
    "payload": "3.92.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "postprocessing": "^6.39.5",
    "rate-limiter-flexible": "^11.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "tempus": "^1.0.0",
    "three": "^0.186.1",
    "vanilla-cookieconsent": "^3.1.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@clack/prompts": "^1.8.1",
    "@csstools/postcss-global-data": "^4.0.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@oxlint/plugins": "1.89.0",
    "@playwright/test": "1.64.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "colorjs.io": "^0.7.1",
    "deslop-cli": "^0.9.12",
    "lefthook": "^2.2.1",
    "linkinator": "^8.1.0",
    "msw": "^3.0.3",
    "oxc-parser": "0.155.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "^8.5.31",
    "postcss-functions": "^4.0.2",
    "postcss-preset-env": "^11.6.1",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "undici": "7.30.1"
    },
    "@next/env": "npm:@dotenvx/next-env",
    "@vercel/frameworks": {
      "js-yaml": "3.15.2"
    },
    "dompurify": "3.4.17",
    "happy-dom": "21.0.4",
    "playwright-core": "1.64.1",
    "smol-toml": "1.9.1",
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "bun@1.4.4",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "trustedDependencies": [
    "oxlint",
    "oxfmt",
    "@swc/core",
    "@tailwindcss/oxide",
    "esbuild",
    "lefthook",
    "sharp"
  ]
}
